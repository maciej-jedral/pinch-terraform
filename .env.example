# Copy to .env (gitignored). Loaded by ./tf before running Terraform.
# Create the key at https://console.neon.tech -> Account settings -> API keys
NEON_API_KEY=
# Porkbun -> Account -> API Access -> Create API key. The domain itself must also
# have "API Access" switched on in its details page, or every call returns 403.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
